# Example environment configuration for Oracle Cloud ARM Hunter
# Rename to .env for local usage or configure these in GitHub Secrets

TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

COMPARTMENT_ID="ocid1.tenancy.oc1..aaaaaa..."
SUBNET_ID="ocid1.subnet.oc1.eu-frankfurt-1.aaaaaa..."
SSH_PUBLIC_KEY="ssh-rsa AAAAB3NzaC1yc2EAAA..."

OCPUS="2"
MEMORY_IN_GBS="12"
CHECK_INTERVAL="60"
DOMAIN_SWITCH_DELAY="10"
MAX_RUN_TIME_MINUTES="0"

